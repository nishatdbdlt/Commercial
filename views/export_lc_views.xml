<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_export_lc_list" model="ir.ui.view">
        <field name="name">commercial.export.lc.list</field>
        <field name="model">commercial.export.lc</field>
        <field name="arch" type="xml">
            <list string="Export LCs" decoration-danger="days_to_expiry &lt; 0 and state in ('received','running')"
                  decoration-muted="state in ('closed','cancelled')">
                <field name="name"/>
                <field name="lc_number"/>
                <field name="lc_type"/>
                <field name="buyer_id"/>
                <field name="issuing_bank_id" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amended_value" sum="Total"/>
                <field name="btb_percent" optional="show"/>
                <field name="shipped_value" optional="show"/>
                <field name="balance_value" optional="show"/>
                <field name="issue_date" optional="hide"/>
                <field name="last_shipment_date" optional="show"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'running'"
                       decoration-info="state == 'received'"/>
            </list>
        </field>
    </record>

    <record id="view_commercial_export_lc_form" model="ir.ui.view">
        <field name="name">commercial.export.lc.form</field>
        <field name="model">commercial.export.lc</field>
        <field name="arch" type="xml">
            <form string="Export LC">
                <header>
                    <button name="action_receive" string="Mark Received" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_run" string="Start Running" type="object" class="btn-primary"
                            invisible="state != 'received'"/>
                    <button name="action_close" string="Close LC" type="object"
                            invisible="state not in ('received', 'running')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,running,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="sale_order_count" widget="statinfo" string="Sale Orders"/>
                        </button>
                        <button name="action_view_pi" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="pi_count" widget="statinfo" string="PIs"/>
                        </button>
                        <button name="action_view_btb" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="btb_count" widget="statinfo" string="BBLCs"/>
                        </button>
                        <button name="action_view_ud" type="object" class="oe_stat_button" icon="fa-certificate">
                            <field name="ud_count" widget="statinfo" string="UDs"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-ship">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_submissions" type="object" class="oe_stat_button" icon="fa-university">
                            <field name="submission_count" widget="statinfo" string="Submissions"/>
                        </button>
                        <button name="action_view_realizations" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="realization_count" widget="statinfo" string="Realizations"/>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not over_value">
                        Invoiced value is more than the LC value plus tolerance. Please check before bank submission.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lc_number"/>
                            <field name="lc_type"/>
                            <field name="buyer_id"/>
                            <field name="issuing_bank_id"/>
                            <field name="advising_bank_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="lc_value"/>
                            <field name="amended_value"/>
                            <field name="tolerance_percent"/>
                            <field name="btb_limit_percent"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="issue_date"/>
                            <field name="last_shipment_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry"/>
                        </group>
                        <group string="Terms">
                            <field name="payment_terms"/>
                            <field name="usance_days"/>
                            <field name="incoterm"/>
                        </group>
                    </group>
                    <group string="Utilization">
                        <group>
                            <field name="btb_total"/>
                            <field name="btb_percent"/>
                            <field name="over_value" invisible="1"/>
                        </group>
                        <group>
                            <field name="shipped_value"/>
                            <field name="balance_value"/>
                            <field name="realized_value"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Amendments" name="amendments">
                            <field name="amendment_ids">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amendment_no"/>
                                    <field name="date"/>
                                    <field name="value_change"/>
                                    <field name="new_expiry_date"/>
                                    <field name="new_last_shipment_date"/>
                                    <field name="description"/>
                                </list>
                            </field>
                            <p class="text-muted">Date changes are applied to the LC when the amendment line is saved.</p>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_commercial_export_lc_search" model="ir.ui.view">
        <field name="name">commercial.export.lc.search</field>
        <field name="model">commercial.export.lc</field>
        <field name="arch" type="xml">
            <search string="Search LC">
                <field name="lc_number"/>
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="issuing_bank_id"/>
                <filter name="running" string="Running" domain="[('state', 'in', ('received', 'running'))]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="expiring_soon" string="Expiring in 30 days"
                        domain="[('state', 'in', ('received', 'running')), ('expiry_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="my_lc" string="My LCs" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_buyer" string="Buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter name="group_bank" string="Issuing Bank" context="{'group_by': 'issuing_bank_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_expiry" string="Expiry Month" context="{'group_by': 'expiry_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_commercial_export_lc_graph" model="ir.ui.view">
        <field name="name">commercial.export.lc.graph</field>
        <field name="model">commercial.export.lc</field>
        <field name="arch" type="xml">
            <graph string="LC Value by Buyer" type="bar">
                <field name="buyer_id"/>
                <field name="amended_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_commercial_export_lc_pivot" model="ir.ui.view">
        <field name="name">commercial.export.lc.pivot</field>
        <field name="model">commercial.export.lc</field>
        <field name="arch" type="xml">
            <pivot string="LC Analysis">
                <field name="buyer_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amended_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_commercial_export_lc" model="ir.actions.act_window">
        <field name="name">Export LCs</field>
        <field name="res_model">commercial.export.lc</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Export LC</p>
            <p>Record the buyer's Export LC or Sales Contract and track BBLC, UD, shipment and realization from here.</p>
        </field>
    </record>
</odoo>
