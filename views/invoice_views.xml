<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_invoice_list" model="ir.ui.view">
        <field name="name">commercial.invoice.list</field>
        <field name="model">commercial.invoice</field>
        <field name="arch" type="xml">
            <list string="Commercial Invoices" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="invoice_number"/>
                <field name="invoice_date"/>
                <field name="buyer_id"/>
                <field name="export_lc_id"/>
                <field name="bl_number" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_qty" sum="Qty" optional="show"/>
                <field name="total_cartons" sum="Cartons" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'submitted'" decoration-success="state == 'realized'"/>
            </list>
        </field>
    </record>

    <record id="view_commercial_invoice_form" model="ir.ui.view">
        <field name="name">commercial.invoice.form</field>
        <field name="model">commercial.invoice</field>
        <field name="arch" type="xml">
            <form string="Commercial Invoice">
                <header>
                    <button name="action_create_bank_submission" string="Prepare Bank Submission"
                            type="object" invisible="state != 'confirmed'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_load_from_sale_order" string="Load from Sale Order" type="object"
                            invisible="state != 'draft' or not sale_order_id"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,submitted,realized"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="invoice_number"/>
                            <field name="invoice_date"/>
                            <field name="export_lc_id"/>
                            <field name="buyer_id"/>
                            <field name="sale_order_id" domain="[('commercial_lc_id', '=', export_lc_id)]"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="incoterm"/>
                            <field name="exp_number"/>
                            <field name="exp_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Shipment">
                        <group>
                            <field name="shipment_date"/>
                            <field name="bl_number"/>
                            <field name="bl_date"/>
                            <field name="container_no"/>
                        </group>
                        <group>
                            <field name="vessel"/>
                            <field name="port_loading"/>
                            <field name="port_discharge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items / Packing" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="style_no"/>
                                    <field name="description"/>
                                    <field name="hs_code" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                    <field name="cartons"/>
                                    <field name="net_weight"/>
                                    <field name="gross_weight"/>
                                    <field name="cbm"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field name="total_qty"/>
                                    <field name="total_cartons"/>
                                    <field name="total_net_weight"/>
                                    <field name="total_gross_weight"/>
                                    <field name="total_cbm"/>
                                </group>
                                <group class="oe_subtotal_footer">
                                    <field name="amount_total"/>
                                </group>
                            </group>
                        </page>
                        <page string="Marks / Notes" name="notes">
                            <group>
                                <field name="marks"/>
                                <field name="note"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_commercial_invoice_search" model="ir.ui.view">
        <field name="name">commercial.invoice.search</field>
        <field name="model">commercial.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Invoice">
                <field name="invoice_number"/>
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="export_lc_id"/>
                <field name="bl_number"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Ready for Bank" domain="[('state', '=', 'confirmed')]"/>
                <filter name="submitted" string="With Bank" domain="[('state', '=', 'submitted')]"/>
                <filter name="realized" string="Realized" domain="[('state', '=', 'realized')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_buyer" string="Buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter name="group_lc" string="Export LC" context="{'group_by': 'export_lc_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Invoice Month" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commercial_invoice" model="ir.actions.act_window">
        <field name="name">Commercial Invoices</field>
        <field name="res_model">commercial.invoice</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
