<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_realization_list" model="ir.ui.view">
        <field name="name">commercial.realization.list</field>
        <field name="model">commercial.realization</field>
        <field name="arch" type="xml">
            <list string="Realizations">
                <field name="name"/>
                <field name="date"/>
                <field name="submission_id"/>
                <field name="export_lc_id"/>
                <field name="buyer_id" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="invoice_amount"/>
                <field name="total_deduction" optional="show"/>
                <field name="received_amount" sum="Received"/>
                <field name="exchange_rate" optional="hide"/>
                <field name="bdt_amount" sum="BDT" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_commercial_realization_form" model="ir.ui.view">
        <field name="name">commercial.realization.form</field>
        <field name="model">commercial.realization</field>
        <field name="arch" type="xml">
            <form string="Realization">
                <header>
                    <button name="action_confirm" string="Confirm Realization" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="submission_id" readonly="state == 'done'"/>
                            <field name="export_lc_id"/>
                            <field name="buyer_id"/>
                            <field name="date" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="invoice_amount"/>
                            <field name="total_deduction"/>
                            <field name="received_amount" readonly="state == 'done'"/>
                            <field name="exchange_rate" readonly="state == 'done'"/>
                            <field name="bdt_amount"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deductions" name="deductions">
                            <field name="deduction_ids" readonly="state == 'done'">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="deduction_type"/>
                                    <field name="description"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes"><field name="note"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_commercial_realization_search" model="ir.ui.view">
        <field name="name">commercial.realization.search</field>
        <field name="model">commercial.realization</field>
        <field name="arch" type="xml">
            <search string="Search Realization">
                <field name="name"/>
                <field name="submission_id"/>
                <field name="export_lc_id"/>
                <field name="buyer_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Realized" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_buyer" string="Buyer" context="{'group_by': 'buyer_id'}"/>
                    <filter name="group_lc" string="Export LC" context="{'group_by': 'export_lc_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commercial_realization" model="ir.actions.act_window">
        <field name="name">Realizations</field>
        <field name="res_model">commercial.realization</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
