<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_commercial" model="ir.ui.view">
        <field name="name">sale.order.form.commercial</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="commercial_lc_id"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_commercial" model="ir.ui.view">
        <field name="name">purchase.order.form.commercial</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="commercial_pi_id"/>
                <field name="commercial_btb_lc_id"/>
            </xpath>
        </field>
    </record>
</odoo>
