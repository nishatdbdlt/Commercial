<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_btb_lc_list" model="ir.ui.view">
        <field name="name">commercial.btb.lc.list</field>
        <field name="model">commercial.btb.lc</field>
        <field name="arch" type="xml">
            <list string="Back-to-Back LCs" decoration-muted="state in ('paid','cancelled')">
                <field name="name"/>
                <field name="btb_number"/>
                <field name="btb_type" optional="show"/>
                <field name="supplier_id"/>
                <field name="export_lc_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="value" sum="Total"/>
                <field name="issue_date" optional="show"/>
                <field name="maturity_date"/>
                <field name="state" widget="badge" decoration-info="state == 'opened'"
                       decoration-warning="state == 'accepted'" decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_commercial_btb_lc_form" model="ir.ui.view">
        <field name="name">commercial.btb.lc.form</field>
        <field name="model">commercial.btb.lc</field>
        <field name="arch" type="xml">
            <form string="Back-to-Back LC">
                <header>
                    <button name="action_link_available_pis" string="Link Confirmed PIs" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_open" string="Open LC" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_accept" string="Mark Accepted" type="object" class="btn-primary"
                            invisible="state != 'opened'"/>
                    <button name="action_paid" string="Mark Paid" type="object" class="btn-primary"
                            invisible="state != 'accepted'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,opened,accepted,paid"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="btb_number"/>
                            <field name="btb_type"/>
                            <field name="supplier_id"/>
                            <field name="export_lc_id"/>
                            <field name="issuing_bank_id"/>
                            <field name="ud_id" domain="[('export_lc_id', '=', export_lc_id)]"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="value"/>
                            <field name="margin_percent"/>
                            <field name="margin_amount"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                        </group>
                        <group string="Usance / Maturity">
                            <field name="usance_days"/>
                            <field name="acceptance_date"/>
                            <field name="maturity_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Proforma Invoices" name="pis">
                            <field name="pi_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="pi_number"/>
                                    <field name="date"/>
                                    <field name="supplier_id"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes"><field name="note"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_commercial_btb_lc_search" model="ir.ui.view">
        <field name="name">commercial.btb.lc.search</field>
        <field name="model">commercial.btb.lc</field>
        <field name="arch" type="xml">
            <search string="Search BBLC">
                <field name="btb_number"/>
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="export_lc_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('opened', 'accepted'))]"/>
                <filter name="maturing" string="Maturing in 30 days"
                        domain="[('state', '=', 'accepted'), ('maturity_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_supplier" string="Supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_lc" string="Master LC" context="{'group_by': 'export_lc_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_maturity" string="Maturity Month" context="{'group_by': 'maturity_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commercial_btb_lc" model="ir.actions.act_window">
        <field name="name">Back-to-Back LCs</field>
        <field name="res_model">commercial.btb.lc</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
